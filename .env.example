# ─────────────────────────────────────────────────────────────
# TTC Aalo — environment variables
# Copy this file to `.env` (local) or add the values in Vercel →
# Project → Settings → Environment Variables. Never commit `.env`.
# Variables starting with NEXT_PUBLIC_ are visible in the browser;
# everything else stays on the server.
# ─────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase or any Postgres 14+).
# Neon: use the *pooled* connection string and keep `sslmode=require`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# sitemap, Open Graph images and links in emails.
NEXT_PUBLIC_SITE_URL="https://ttcaalo.org.in"

# Secret for signing login sessions. Generate one with:  npx auth secret
#   or:  openssl rand -base64 33
AUTH_SECRET=""

# ── First Super Admin (used by `npm run db:seed`, optional) ──
# If set, the seed creates this Super Admin. You can instead run
# `npm run create-admin` at any time. Remove these after first use.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Super Admin"

# ── Google sign-in for staff (optional) ──────────────────────
# Only staff who were already invited can use Google sign-in.
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email: Resend (recommended) ──────────────────────────────
# Enquiry alerts, student auto-replies, grievance receipts and staff invites.
# Without a key, emails are only logged to the server console.
# Verify your domain at https://resend.com/domains first.
RESEND_API_KEY=""
EMAIL_FROM="TTC Aalo <admissions@ttcaalo.org.in>"
# Extra comma-separated addresses that receive new-enquiry alerts
# (in addition to the admissions email set in Admin → Site settings).
ADMISSIONS_NOTIFY_EMAIL=""
# Who receives new-grievance alerts (defaults to the public email in settings).
GRIEVANCE_NOTIFY_EMAIL=""

# ── File uploads: Cloudinary (required in production) ────────
# Either the single CLOUDINARY_URL from your Cloudinary dashboard…
CLOUDINARY_URL=""
# …or the three separate values:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder to keep this site's files in.
CLOUDINARY_FOLDER="ttc-aalo"
# Local development without Cloudinary saves files to /public/uploads.
# Set to 1 only if you self-host on a server with a persistent disk.
ALLOW_LOCAL_UPLOADS=""

# ── Spam protection: Cloudflare Turnstile (recommended) ──────
# https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both empty in local development to skip the check.
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Rate limiting: Upstash Redis (recommended in production) ─
# Limits enquiry, grievance, login and upload attempts across all servers.
# Without these, an in-memory limiter is used (fine for local development).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Analytics ────────────────────────────────────────────────
# Vercel Analytics turns on automatically when deployed on Vercel.
# GA4 and Meta Pixel IDs are entered in Admin → Site settings and only
# load after a visitor accepts the cookie banner.

# ── End-to-end tests (optional) ──────────────────────────────
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""
# E2E_BASE_URL="https://preview-url.vercel.app"   # test a deployed site instead of a local build
# PLAYWRIGHT_CHROMIUM_PATH=""                     # use an existing Chromium binary
