// TTC Aalo — data model
// Every public-facing piece of content lives here so the admin CMS can edit it.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  ADMISSIONS_OFFICER
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ProgrammeStatus {
  ACTIVE
  VERIFY
  DRAFT
  ARCHIVED
}

enum NoticeCategory {
  ADMISSION
  EXAM
  ACADEMIC
  GENERAL
}

enum StaffType {
  LEADERSHIP
  TEACHING
  NON_TEACHING
}

enum DownloadCategory {
  ADMISSION_FORM
  PROSPECTUS
  NCTE_RECOGNITION
  RGU_AFFILIATION
  RTI
  GRIEVANCE_REDRESSAL
  ANTI_RAGGING
  ADMISSION_COMMITTEE
  IQAC
  MANDATORY_DISCLOSURE
  OTHER
}

enum NavMenu {
  HEADER
  FOOTER_EXPLORE
  FOOTER_STUDENTS
  FOOTER_LEGAL
}

enum MediaKind {
  IMAGE
  DOCUMENT
}

enum LeadStage {
  NEW
  CONTACTED
  ELIGIBLE
  APPLICATION_STARTED
  APPLICATION_SUBMITTED
  ENROLLED
  NOT_ELIGIBLE
  LOST
}

enum LeadActivityType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  STAGE_CHANGE
  ASSIGNMENT
  SYSTEM
}

enum GrievanceStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum Category {
  GENERAL
  EWS
  OBC
  SC
  ST
  PWD
}

// ─────────────────────────────────────────────────────────────
// Users & access
// ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role      @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invitesSent     Invite[]        @relation("InvitedBy")
  assignedLeads   Lead[]          @relation("LeadAssignee")
  leadActivities  LeadActivity[]
  followUps       FollowUp[]      @relation("FollowUpAssignee")
  auditLogs       AuditLog[]
  versions        ContentVersion[]
  media           Media[]
  grievances      Grievance[]     @relation("GrievanceAssignee")
}

/// Single-use token for invitations and password resets. Only the SHA-256 hash is stored.
model Invite {
  id          String    @id @default(cuid())
  email       String
  name        String?
  role        Role
  tokenHash   String    @unique
  purpose     String    @default("invite") // "invite" | "reset"
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// Media
// ─────────────────────────────────────────────────────────────

model Media {
  id           String    @id @default(cuid())
  kind         MediaKind
  url          String
  publicId     String?
  filename     String
  mimeType     String
  bytes        Int
  width        Int?
  height       Int?
  alt          String    @default("")
  caption      String?
  blurDataUrl  String?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  settingsLogo     SiteSettings[] @relation("SettingsLogo")
  settingsFavicon  SiteSettings[] @relation("SettingsFavicon")
  settingsOg       SiteSettings[] @relation("SettingsOg")
  settingsPrincipal SiteSettings[] @relation("SettingsPrincipal")
  sections         Section[]
  pagesHero        Page[]          @relation("PageHero")
  pagesOg          Page[]          @relation("PageOg")
  programmesHero   Programme[]     @relation("ProgrammeHero")
  programmesOg     Programme[]     @relation("ProgrammeOg")
  notices          Notice[]        @relation("NoticeAttachment")
  noticesOg        Notice[]        @relation("NoticeOg")
  faculty          FacultyMember[]
  facilities       Facility[]
  events           Event[]         @relation("EventCover")
  eventsOg         Event[]         @relation("EventOg")
  albums           Album[]
  testimonials     Testimonial[]
  downloads        Download[]
  seoEntries       SeoEntry[]

  @@index([kind, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Site-wide settings (singleton, id = "site")
// ─────────────────────────────────────────────────────────────

model SiteSettings {
  id                 String   @id @default("site")
  siteName           String
  shortName          String
  tagline            String
  description        String
  established        Int?
  campusAcres        Int?
  affiliation        String
  recognition        String
  managedBy          String

  logoId             String?
  logo               Media?   @relation("SettingsLogo", fields: [logoId], references: [id], onDelete: SetNull)
  faviconId          String?
  favicon            Media?   @relation("SettingsFavicon", fields: [faviconId], references: [id], onDelete: SetNull)
  defaultOgImageId   String?
  defaultOgImage     Media?   @relation("SettingsOg", fields: [defaultOgImageId], references: [id], onDelete: SetNull)

  primaryColor       String?
  accentColor        String?

  phone              String?
  altPhone           String?
  email              String?
  admissionsEmail    String?
  whatsappNumber     String?
  whatsappMessage    String?
  addressLine        String
  city               String
  district           String
  state              String
  postalCode         String
  mapEmbedUrl        String?
  mapLink            String?
  officeHours        String?

  facebookUrl        String?
  instagramUrl       String?
  youtubeUrl         String?
  xUrl               String?
  linkedinUrl        String?

  admissionsOpen     Boolean  @default(false)
  admissionsSession  String
  admissionsBadge    String?

  announcementEnabled Boolean @default(false)
  announcementText   String?
  announcementLink   String?
  announcementLinkLabel String?

  principalName      String?
  principalTitle     String?
  principalMessage   String?
  principalPhotoId   String?
  principalPhoto     Media?   @relation("SettingsPrincipal", fields: [principalPhotoId], references: [id], onDelete: SetNull)

  footerAbout        String?
  footerNote         String?

  gaMeasurementId    String?
  metaPixelId        String?

  updatedAt          DateTime @updatedAt
}

/// SEO overrides for fixed routes ("/", "/admissions", ...).
model SeoEntry {
  id          String  @id @default(cuid())
  path        String  @unique
  label       String
  title       String?
  description String?
  ogImageId   String?
  ogImage     Media?  @relation(fields: [ogImageId], references: [id], onDelete: SetNull)
  noindex     Boolean @default(false)
  updatedAt   DateTime @updatedAt
}

/// Editable blocks on fixed pages (home, about, admissions...).
/// `key` identifies the renderer; `items` holds repeatable cards.
model Section {
  id        String   @id @default(cuid())
  page      String   @default("home")
  key       String   @unique
  label     String
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  eyebrow   String?
  title     String?
  subtitle  String?
  body      String?
  ctaLabel  String?
  ctaHref   String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  imageId   String?
  image     Media?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt

  @@index([page, order])
}

model NavItem {
  id        String   @id @default(cuid())
  menu      NavMenu
  label     String
  href      String
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  newTab    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([menu, order])
}

// ─────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  body           String        @default("")
  heroImageId    String?
  heroImage      Media?        @relation("PageHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  status         ContentStatus @default(DRAFT)
  system         Boolean       @default(false)
  seoTitle       String?
  seoDescription String?
  ogImageId      String?
  ogImage        Media?        @relation("PageOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  noindex        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Programme {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  shortName       String
  tagline         String?
  summary         String
  overview        String          @default("")
  level           String
  duration        String?
  semesters       Int?
  intake          Int?
  affiliation     String?
  recognition     String?
  approvalNote    String?
  status          ProgrammeStatus @default(DRAFT)
  order           Int             @default(0)
  /// [{ category, requirement }]
  eligibility     Json            @default("[]")
  eligibilityNotes String?
  subjects        String[]        @default([])
  /// [{ title, description }]
  careers         Json            @default("[]")
  /// [{ label, amount, note }] — leave empty until verified
  fees            Json            @default("[]")
  feesNote        String?
  documents       String[]        @default([])
  seatsAvailable  Int?
  applicationDeadline DateTime?
  heroImageId     String?
  heroImage       Media?          @relation("ProgrammeHero", fields: [heroImageId], references: [id], onDelete: SetNull)
  seoTitle        String?
  seoDescription  String?
  ogImageId       String?
  ogImage         Media?          @relation("ProgrammeOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  noindex         Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  eligibilityRules EligibilityRule[]
  admissionDates   AdmissionDate[]
  leads            Lead[]
}

model AdmissionDate {
  id          String        @id @default(cuid())
  label       String
  date        DateTime?
  endDate     DateTime?
  note        String?
  programmeId String?
  programme   Programme?    @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  updatedAt   DateTime      @updatedAt
}

/// Rules used by the public eligibility checker.
model EligibilityRule {
  id            String        @id @default(cuid())
  programmeId   String
  programme     Programme     @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  category      Category
  /// Allowed highest qualifications, e.g. ["BACHELORS", "MASTERS"]
  qualifications String[]     @default([])
  /// Leave empty when the exact cut-off is "as per Government rules" and not yet confirmed.
  minPercent    Float?
  resultNote    String?
  order         Int           @default(0)
  status        ContentStatus @default(PUBLISHED)
  updatedAt     DateTime      @updatedAt

  @@index([programmeId, category])
}

model Notice {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  category       NoticeCategory @default(GENERAL)
  summary        String?
  body           String         @default("")
  pinned         Boolean        @default(false)
  publishedAt    DateTime       @default(now())
  expiresAt      DateTime?
  attachmentId   String?
  attachment     Media?         @relation("NoticeAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  externalLink   String?
  status         ContentStatus  @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  ogImageId      String?
  ogImage        Media?         @relation("NoticeOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  noindex        Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt])
}

model FacultyMember {
  id             String        @id @default(cuid())
  name           String
  designation    String
  department     String?
  type           StaffType     @default(TEACHING)
  qualifications String?
  specialisation String?
  experience     String?
  email          String?
  bio            String?
  photoId        String?
  photo          Media?        @relation(fields: [photoId], references: [id], onDelete: SetNull)
  order          Int           @default(0)
  status         ContentStatus @default(DRAFT)
  updatedAt      DateTime      @updatedAt
}

model Facility {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  category    String
  summary     String
  description String        @default("")
  highlights  String[]      @default([])
  coverId     String?
  cover       Media?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  /// [{ mediaId, caption }]
  images      Json          @default("[]")
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  updatedAt   DateTime      @updatedAt
}

model Event {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  startsAt       DateTime
  endsAt         DateTime?
  location       String?
  summary        String
  body           String        @default("")
  coverId        String?
  cover          Media?        @relation("EventCover", fields: [coverId], references: [id], onDelete: SetNull)
  albumId        String?
  album          Album?        @relation(fields: [albumId], references: [id], onDelete: SetNull)
  status         ContentStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  ogImageId      String?
  ogImage        Media?        @relation("EventOg", fields: [ogImageId], references: [id], onDelete: SetNull)
  noindex        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Album {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String?
  category    String        @default("Campus life")
  coverId     String?
  cover       Media?        @relation(fields: [coverId], references: [id], onDelete: SetNull)
  /// [{ mediaId, caption }]
  images      Json          @default("[]")
  showOnHome  Boolean       @default(false)
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  updatedAt   DateTime      @updatedAt

  events Event[]
}

model Testimonial {
  id          String        @id @default(cuid())
  name        String
  role        String
  quote       String
  photoId     String?
  photo       Media?        @relation(fields: [photoId], references: [id], onDelete: SetNull)
  /// Must be ticked before publishing: the person agreed to be quoted.
  consent     Boolean       @default(false)
  showOnHome  Boolean       @default(true)
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  updatedAt   DateTime      @updatedAt
}

model Faq {
  id         String        @id @default(cuid())
  question   String
  answer     String
  category   String        @default("Admissions")
  showOnHome Boolean       @default(false)
  order      Int           @default(0)
  status     ContentStatus @default(DRAFT)
  updatedAt  DateTime      @updatedAt
}

model Download {
  id          String           @id @default(cuid())
  title       String
  description String?
  category    DownloadCategory @default(OTHER)
  fileId      String?
  file        Media?           @relation(fields: [fileId], references: [id], onDelete: SetNull)
  externalUrl String?
  issuedOn    DateTime?
  order       Int              @default(0)
  status      ContentStatus    @default(DRAFT)
  updatedAt   DateTime         @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Leads CRM
// ─────────────────────────────────────────────────────────────

model Lead {
  id              String     @id @default(cuid())
  name            String
  phone           String
  email           String?
  programmeId     String?
  programme       Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  programmeName   String?
  district        String?
  qualification   String?
  percentage      Float?
  category        Category?
  preferredTime   String?
  message         String?
  formName        String     @default("enquiry")

  consent         Boolean
  consentText     String
  consentAt       DateTime

  source          String     @default("direct")
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  referrer        String?
  landingPage     String?
  userAgent       String?

  stage           LeadStage  @default(NEW)
  lostReason      String?
  assignedToId    String?
  assignedTo      User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastContactedAt DateTime?
  stageChangedAt  DateTime   @default(now())

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  activities      LeadActivity[]
  followUps       FollowUp[]

  @@index([stage, createdAt])
  @@index([createdAt])
  @@index([utmCampaign])
  @@index([phone])
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType
  body        String
  outcome     String?
  authorId    String?
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([leadId, createdAt])
}

model FollowUp {
  id           String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueAt        DateTime
  note         String?
  doneAt       DateTime?
  assignedToId String?
  assignedTo   User?     @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([dueAt, doneAt])
}

/// Ad campaigns, matched to leads by utm_campaign, for cost-per-lead reporting.
model Campaign {
  id          String    @id @default(cuid())
  name        String
  utmCampaign String    @unique
  channel     String    @default("Meta Ads")
  /// Total spend in rupees.
  spend       Float?
  startDate   DateTime?
  endDate     DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Grievances
// ─────────────────────────────────────────────────────────────

model Grievance {
  id             String          @id @default(cuid())
  ticket         String          @unique
  name           String?
  email          String?
  phone          String?
  role           String
  category       String
  subject        String
  description    String
  anonymous      Boolean         @default(false)
  status         GrievanceStatus @default(OPEN)
  resolution     String?
  internalNotes  String?
  assignedToId   String?
  assignedTo     User?           @relation("GrievanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Audit & versioning
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model ContentVersion {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  data       Json
  note       String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}
